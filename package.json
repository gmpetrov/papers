{
  "name": "agentinfra",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "dotenv -e .env -- vitest run && turbo run test",
    "db:generate": "pnpm --filter @agentinfra/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @agentinfra/db migrate",
    "jobs": "dotenv -e .env -- tsx apps/jobs/src/local.ts",
    "jobs:status": "dotenv -e .env -- tsx scripts/job-status.ts"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "dotenv-cli": "latest",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "4.132.0"
  },
  "type": "module"
}
