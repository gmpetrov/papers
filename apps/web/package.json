    "@agentinfra/core": "workspace:*",
    "@agentinfra/db": "workspace:*",
    "@agentinfra/mcp": "workspace:*",
    "@agentinfra/providers": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "latest",
    "@papers.bot/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "latest",
    "next": "16.3.5",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "postcss": "^8.5.28",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "latest"
