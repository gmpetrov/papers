{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "papers-jobs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "queues": {
    "consumers": [
      {
        "queue": "papers-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 60,
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace this placeholder with the deployment's Hyperdrive ID.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://agentinfra:agentinfra_local@localhost:55433/agentinfra_test",
    },
  ],
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "papers-attachments" },
  ],
  // Keep disabled for local workerd. Deploy standalone (no origin routes) and
  // set WEBHOOK_TRANSPORT=cloudflare to use Cloudflare's public-only egress.
  "vars": {
    "TELNYX_STATUS": "active",
    "WEBHOOK_TRANSPORT": "disabled",
    "BILLING_ENABLED": "false",
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY",
      "TELNYX_API_KEY",
      "CUSTOM_WEBHOOK_ENCRYPTION_KEY",
      "STRIPE_SECRET_KEY",
      "TELNYX_PUBLIC_KEY",
      "TELNYX_MESSAGING_PROFILE_ID",
    ],
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
