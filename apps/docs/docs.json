{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "Papers",
  "description": "Email and SMS for agents. API guides, SDKs, permissions, and webhooks.",
  "colors": {
    "primary": "#166E3F",
    "light": "#26BD6C",
    "dark": "#166E3F"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Pricing",
        "href": "https://www.papers.bot/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://www.papers.bot/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Email",
            "pages": [
              "email/inboxes",
              "email/messages",
              "email/threads",
              "email/attachments"
            ]
          },
          {
            "group": "Phone and SMS",
            "pages": [
              "phone/numbers",
              "phone/sms"
            ]
          },
          {
            "group": "Connect your agent",
            "pages": [
              "connections/typescript",
              "connections/python",
              "connections/mcp",
              "connections/cli"
            ]
          },
          {
            "group": "Webhooks and events",
            "pages": [
              "webhooks/overview",
              "webhooks/verification",
              "webhooks/events"
            ]
          },
          {
            "group": "Workspace",
            "pages": [
              "workspace/members",
              "workspace/permissions",
              "workspace/approvals",
              "workspace/limits",
              "workspace/billing"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/api-basics",
              "reference/operations",
              "reference/errors"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "redirects": [
    {
      "source": "/platform/quickstart",
      "destination": "/quickstart"
    },
    {
      "source": "/platform/key-concepts",
      "destination": "/index"
    },
    {
      "source": "/platform/configuration/settings",
      "destination": "/workspace/limits"
    },
    {
      "source": "/platform/configuration/user-management",
      "destination": "/workspace/members"
    },
    {
      "source": "/platform/administration/roles-permissions",
      "destination": "/workspace/permissions"
    },
    {
      "source": "/integrations/quickstart",
      "destination": "/connections/mcp"
    },
    {
      "source": "/integrations/authentication",
      "destination": "/authentication"
    },
    {
      "source": "/integrations/webhooks/configure",
      "destination": "/webhooks/overview"
    }
  ]
}
