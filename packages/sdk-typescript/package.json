{
  "name": "@papers.bot/sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup src/index.ts --format esm --clean && tsc --noEmit false --declaration --emitDeclarationOnly --outDir dist"
  },
  "dependencies": {
    "standardwebhooks": "^1.1.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "description": "Typed TypeScript client for Papers email and phone infrastructure",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmpetrov/papers.git",
    "directory": "packages/sdk-typescript"
  },
  "engines": {
    "node": ">=22"
  }
}
