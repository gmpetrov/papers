DATABASE_URL=postgresql://agentinfra:agentinfra_local@localhost:55433/agentinfra
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Deployed Mintlify origin, for example https://your-subdomain.mintlify.site
MINTLIFY_DOCS_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DOMAIN=
AUTH_EMAIL_FROM=
TELNYX_STATUS=under_review
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY=
# Optional override; defaults to BETTER_AUTH_URL + /api/webhooks/telnyx
# TELNYX_WEBHOOK_URL=https://your-host/api/webhooks/telnyx
# Base64url-encoded 32-byte key for encrypted customer webhook signing secrets.
CUSTOM_WEBHOOK_ENCRYPTION_KEY=

# Billing is opt-in for local development. Production enables enforcement.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
# Keep false until provider inbound suspension and rate ceilings are verified.
